# ── Application ──────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Database ──────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=pumpwatch
POSTGRES_USER=pumpwatch
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql+asyncpg://pumpwatch:change-me@db:5432/pumpwatch

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Blockchain Providers ──────────────────────────────────
ETHERSCAN_API_KEY=your-etherscan-api-key
# ALCHEMY_API_KEY=
# INFURA_PROJECT_ID=
# MORALIS_API_KEY=

ACTIVE_BLOCKCHAIN_PROVIDER=etherscan

# ── Price Oracle ──────────────────────────────────────────
# Leave blank to use CoinGecko free tier (30 req/min)
# COINGECKO_API_KEY=your-coingecko-pro-key

# ── Notifications ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@pumpwat.ch

# ── Redis (rate limiting / caching) ──────────────────────
REDIS_URL=redis://redis:6379/0

# ── Scheduler ────────────────────────────────────────────
BLOCKCHAIN_POLL_INTERVAL_SECONDS=30
WHALE_THRESHOLD_USD=100000

# ── AI (Anthropic) ───────────────────────────────────────
# Leave blank to disable AI features (heuristic fallback used)
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-5

# ── CORS ─────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://pumpwat.ch

# ── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.pumpwat.ch
NEXT_PUBLIC_APP_URL=https://pumpwat.ch

# ── Trading Kill Switch ───────────────────────────────────
# Set to true only after verifying risk rules and exchange config in production.
TRADING_ENABLED=false
